worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  sendfile on;
  keepalive_timeout 30s;
  client_header_timeout 15s;
  client_body_timeout 30s;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  client_max_body_size 21m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:TLS:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  # Query strings can contain OAuth codes; never record them.
  log_format runly '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
  access_log /dev/stdout runly;
  limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;
  limit_conn_zone $binary_remote_addr zone=connections:10m;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 300s;
  proxy_send_timeout 300s;
  proxy_buffering off;

  server {
    listen 127.0.0.1:8081;
    access_log off;
    location = /health { return 200 'ok'; }
    location / { return 404; }
  }
  server {
    listen 8080 default_server;
    server_name _;
    return 444;
  }
  server {
    listen 8080;
    server_name ${RUNLY_APP_DOMAIN} ${RUNLY_RUNTIME_DOMAIN} *.${RUNLY_PREVIEW_DOMAIN};
    return 308 https://$host$request_uri;
  }
  server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
  }
  server {
    listen 8443 ssl;
    http2 on;
    server_name ${RUNLY_APP_DOMAIN};
    ssl_certificate /etc/nginx/tls/app.crt;
    ssl_certificate_key /etc/nginx/tls/app.key;
    location ^~ /api/auth/ {
      limit_req zone=auth burst=10 nodelay;
      limit_req_status 429;
      proxy_pass http://127.0.0.1:3000;
    }
    location / { proxy_pass http://127.0.0.1:3000; }
  }
  server {
    listen 8443 ssl;
    http2 on;
    server_name ${RUNLY_RUNTIME_DOMAIN};
    limit_conn connections 100;
    ssl_certificate /etc/nginx/tls/app.crt;
    ssl_certificate_key /etc/nginx/tls/app.key;
    location ^~ /internal/ { return 404; }
    location / { proxy_pass http://127.0.0.1:4001; }
  }
  server {
    listen 8443 ssl;
    http2 on;
    server_name *.${RUNLY_PREVIEW_DOMAIN};
    limit_conn connections 100;
    ssl_certificate /etc/nginx/tls/preview.crt;
    ssl_certificate_key /etc/nginx/tls/preview.key;
    # Preview hostnames contain bearer capabilities. Keep them out of access logs.
    access_log off;
    client_max_body_size 1m;
    location ^~ /internal/ { return 404; }
    location / { proxy_pass http://127.0.0.1:4001; }
  }
}
