# Copy to the ignored .env.prod, then replace all bracketed values.
# Public values are baked into the web image; rebuild when they change.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<browser-safe-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-supabase-key>
OPENAI_API_KEY=<server-only-openai-key>
OPENAI_MODEL=<agents-api-model>
# Optional Decide for me suggestions, separate from the Agents model.
RUNLY_STACK_RECOMMENDER_ENABLED=false
RUNLY_STACK_RECOMMENDER_MODEL=
RUNLY_SITE_URL=https://app.example.com
# Optional public contact address for the Support page.
RUNLY_SUPPORT_EMAIL=
RUNLY_APP_DOMAIN=app.example.com
RUNLY_RUNTIME_DOMAIN=runtime.example.com
RUNLY_RUNTIME_SECRET=<at-least-32-random-characters>
RUNLY_RUNTIME_GATEWAYS=[{"id":"primary","url":"wss://runtime.example.com"}]
RUNLY_RUNTIME_GATEWAY_ID=primary
# Use a different registrable domain for untrusted user previews.
RUNLY_PREVIEW_DOMAIN=preview.example.net
RUNLY_SANDBOX_ALLOWED_DOMAINS=
RUNLY_RUNTIME_MAX_ACTIVE=10
RUNLY_RUNTIME_CONTAINER_SIZE=small
RUNLY_RUNTIME_IDLE_MINUTES=5
RUNLY_RUNTIME_DISCONNECT_GRACE_MINUTES=5
RUNLY_AGENT_TIMEOUT_MINUTES=10
RUNLY_BIND_IP=0.0.0.0
RUNLY_IMAGE_TAG=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RUNLY_BILLING_RECONCILIATION_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
