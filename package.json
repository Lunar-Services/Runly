{
  "name": "runly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:preview": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:stripe": "node scripts/dev.mjs --stripe",
    "dev:runtime": "node scripts/dev.mjs --external-services --runtime",
    "dev:mock": "node scripts/dev-runtime-mock.mjs",
    "runtime": "node --import tsx runtime/gateway.ts",
    "runtime:local-env": "node --env-file=.env.local --import tsx runtime/gateway.ts",
    "test:runtime": "tsx --test runtime/*.test.ts",
    "test:mock": "node runtime/mock-smoke.mjs",
    "build": "next build",
    "build:prod": "node scripts/prod.mjs build",
    "start": "next start",
    "start:prod": "node scripts/prod.mjs start",
    "runtime:prod": "node scripts/prod.mjs runtime",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:secrets": "node scripts/check-staged-secrets.mjs",
    "check": "pnpm exec lint-staged && pnpm run lint && pnpm run security:secrets",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@next/env": "16.3.6",
    "@number-flow/react": "0.6.2",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.5",
    "next": "16.3.6",
    "ogl": "^1.0.11",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.2",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,css,md,yml,yaml}": "prettier --write"
  }
}
