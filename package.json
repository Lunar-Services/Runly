{
  "name": "runly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stripe": "node scripts/dev.mjs --stripe",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:secrets": "node scripts/check-staged-secrets.mjs",
    "check": "pnpm exec lint-staged && pnpm run lint && pnpm run security:secrets",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,css,md,yml,yaml}": "prettier --write"
  }
}
