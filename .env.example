# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RUNLY_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=
RUNLY_CREDENTIAL_ENCRYPTION_KEY=
# Read only by the explicit `pnpm dev:stripe` command or production. Never
# prefix either value with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A random server-only secret for the scheduled Stripe recovery job. On Vercel
# you may instead set its built-in CRON_SECRET variable.
RUNLY_BILLING_RECONCILIATION_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
SANDBOX_WORKER_URL=
SANDBOX_WORKER_TOKEN=

# Shared runtime control plane. Use a random secret of at least 32 characters.
# Gateway URLs MUST be publicly reachable by the OpenAI-hosted sandbox over WSS.
RUNLY_RUNTIME_SECRET=
RUNLY_RUNTIME_GATEWAYS=[{"id":"primary","url":"wss://runtime.example.com"}]
RUNLY_RUNTIME_GATEWAY_ID=primary
RUNLY_RUNTIME_PORT=4001
RUNLY_PREVIEW_DOMAIN=preview.example.com
RUNLY_RUNTIME_MAX_ACTIVE=10
RUNLY_RUNTIME_IDLE_MINUTES=5
RUNLY_AGENT_TIMEOUT_MINUTES=10
